# --- claude-playbook runtime (deployed by bin/deploy.ts, per-install state) ---
# Everything below is written into the playbook config root at deploy time and is
# per-install state — never committed. Entries are root-anchored (leading `/`) so
# the tracked payload under LifeOS/ is untouched; bin/, .playbook, CLAUDE.md, and
# PLAYBOOK.md also stay tracked. (node_modules/, logs/, and .DS_Store are already
# ignored globally above, so they are not repeated here.)

# Deployed payload (from LifeOS/install/ → config root)
/settings.json
/settings.local.json
/hooks/
/skills/
/agents/
/commands/
/runtime/
/USER/
/package.json
/bun.lock
/.lifeos-deploy-state.json
/.lifeos-deploy-inprogress
/.lifeos-deploy-journal.json

# Deploy-adjacent backups (InstallSettings-style timestamped copies, manual fixes)
/settings.json.backup-*

# Claude Code per-instance state
/.claude.json*
/.credentials.json
/backups/
/teams/
/history.jsonl
/projects/
/todos/
/sessions/
/session-env/
/shell-snapshots/
/file-history/
/paste-cache/
/statsig/
/cache/
/plugins/
/.last-*
/remote-settings.json
/policy-limits.json
